config_version=5

[application]

config/name="Echoes of the Last Sky"
config/description="Third-person anime fantasy action RPG set in the Shattered Reach."
config/version="0.1.0-stage1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

